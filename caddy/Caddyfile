# Caddyfile — automatic HTTPS via Let's Encrypt.
#
# Caddy automatically:
# - Obtains a TLS certificate from Let's Encrypt on first start
# - Renews certificates before expiry
# - Redirects HTTP -> HTTPS
#
# Prerequisites:
# - DOMAIN env var set in .env (or docker-compose environment)
# - DNS A record for your domain pointing to this server's IP
# - Ports 80 and 443 open (Caddy needs both for HTTP-01 challenge and HTTPS)

{$DOMAIN} {
	# All traffic -> frontend (nginx serves static assets and proxies /api/* to backend)
	reverse_proxy frontend:3000
}