# yt-dlp Web — Production Environment Variables
#
# Copy this file to .env and fill in your values before deploying:
#   cp .env.example .env
#
# Docker Compose automatically loads .env in the project directory.
# See: https://docs.docker.com/compose/environment-variables/

# ─── Domain (for Caddy TLS) ───
# The domain Caddy will serve with automatic HTTPS via Let's Encrypt.
# Must have an A record pointing to your server's IP.
DOMAIN=neckflix.top

# ─── Security ───
# API key required for POST /api/update (yt-dlp self-upgrade).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable auth (NOT recommended for production).
UPDATE_API_KEY=

# ─── Rate Limiting ───
# Max requests per window per session (or per client IP if no session ID).
RATE_LIMIT_DOWNLOADS=10
RATE_LIMIT_INFO=20
RATE_LIMIT_WINDOW_SECONDS=60

# ─── File Cleanup ───
# Delete unclaimed downloaded files after this many hours.
PURGE_MAX_AGE_HOURS=3
# How often the background purger runs (seconds).
PURGE_INTERVAL_SECONDS=3600
# How long job cards stay visible after download completes (hours).
JOB_CARD_TTL_HOURS=2
# TTL for the "file is being served" Redis flag (seconds).
# Protects files from being purged while actively being downloaded.
SERVING_FLAG_TTL_SECONDS=3600

# ─── Redis ───
# Redis connection URL. Default points to the redis service in Docker Compose.
REDIS_URL=redis://redis:6379/0

# ─── Downloads Directory ───
# Where downloaded files are stored inside the container.
# In production this is a named Docker volume mounted at /app/downloads.
DOWNLOAD_DIR=/app/downloads
SESSION_DIR=/app/downloads/.session
